# Copy to .env.local for local testing. Never commit real values.
# Set the same two values in Vercel: Project Settings > Environment Variables.

# Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Shared secret the demo page and any test client must send as: Authorization: Bearer <key>
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEMO_API_KEY=replace-with-a-long-random-string

# Comma-separated origins allowed to call the API from a browser (CORS).
# Include your local Angular dev server and any admin portal domain.
ALLOWED_ORIGINS=http://localhost:4200
